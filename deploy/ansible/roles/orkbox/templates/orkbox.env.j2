# Managed by Ansible (orkbox role). Changes here are overwritten on the next run;
# set orkbox_settings instead.
ORKBOX_HOST={{ orkbox_host }}
ORKBOX_PORT={{ orkbox_port }}
{% if orkbox_token %}
ORKBOX_TOKEN={{ orkbox_token }}
{% endif %}
{% if orkbox_user and orkbox_password %}
ORKBOX_USER={{ orkbox_user }}
ORKBOX_PASSWORD={{ orkbox_password }}
{% endif %}
ORKBOX_LOCAL_ROOT={{ orkbox_data_dir }}/local
{% for name, value in orkbox_settings | dictsort %}
{{ name }}={{ value }}
{% endfor %}
