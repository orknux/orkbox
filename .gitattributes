# Scripts and Dockerfiles are read inside Linux containers; a CRLF shebang
# fails as "bad interpreter: /bin/sh^M".
*.sh text eol=lf
Dockerfile* text eol=lf
mvnw text eol=lf
mvnw.cmd text eol=crlf
# The Ansible role renders its templates onto Linux hosts as they are; a CRLF
# template ends every value in the env file with a carriage return.
deploy/ansible/** text eol=lf
